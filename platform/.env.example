# Platform impact-loop configuration. All optional; safe non-customer defaults.
# Copy to .env and edit. No real repo/org/module/version values belong here.

# Base URL for UI deep links (default: empty -> relative links)
PLATFORM_DEEP_LINK_BASE_URL=https://infragraph.example.invalid

# Comma-separated IaC file extensions (default: .tf,.hcl)
PLATFORM_IAC_EXTENSIONS=.tf,.hcl

# Require webhook signature verification (default: false; set true in prod)
PLATFORM_REQUIRE_WEBHOOK_SECRET=false

# Policy dials
PLATFORM_BLOCK_ON_BREAKING=true
PLATFORM_BLOCK_ON_DISTURBED=true
PLATFORM_FAIL_CLOSED_ON_UNKNOWN=false

# Notification routing (comma-separated; empty defaults)
PLATFORM_ARCHITECT_RECIPIENTS=
PLATFORM_OWNER_CONTACT_KEYS=owners,oncall,primary_team

# Optional path to a JSON config file (see examples/config.example.json)
# PLATFORM_CONFIG_FILE=./examples/config.example.json

# Webhook secret consumed by the provider adapter (never committed)
# GITHUB_WEBHOOK_SECRET=
